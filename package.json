{
  "name": "oli-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'infra/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'infra/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'infra/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'infra/**/*.ts'",
    "cdk:synth": "cd infra && npx cdk synth",
    "cdk:deploy": "cd infra && npx cdk deploy --all",
    "cdk:diff": "cd infra && npx cdk diff",
    "local:up": "docker compose -f local/docker-compose.yml up -d",
    "local:down": "docker compose -f local/docker-compose.yml down",
    "local:setup": "node local/setup-infra.mjs",
    "local:api": "tsx local/http-runner.mjs",
    "local:seed": "tsx local/seed.mjs",
    "local:poller": "tsx local/poller.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.17.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.0"
  }
}
